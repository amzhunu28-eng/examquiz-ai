FROM python:3.12-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends unzip tesseract-ocr && rm -rf /var/lib/apt/lists/*
COPY ExamQuiz_AI_SOURCE.zip /tmp/app.zip
RUN unzip -q /tmp/app.zip -d /app && rm /tmp/app.zip && rm -f /app/.env
RUN pip install --no-cache-dir -r /app/requirements.txt
ENV PYTHONUNBUFFERED=1
EXPOSE 10000
CMD ["sh", "-c", "uvicorn app:app --host 0.0.0.0 --port ${PORT:-10000}"]
